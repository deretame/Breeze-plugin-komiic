{
  "name": "breeze-plugin-komiic",
  "version": "0.0.5",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "node --import tsx build/generate-version.ts && pnpm typecheck && node --import tsx build/generate-manifest.ts && cross-env NODE_OPTIONS=\"--import tsx\" rspack build && node --import tsx build/generate-brotli.ts",
    "dev": "pnpm dev:serve",
    "dev:serve": "tsx dev-server.ts"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "breeze-plugin-kit": "^0.14.0"
  },
  "devDependencies": {
    "@rspack/cli": "^2.1.8",
    "@rspack/core": "^2.1.8",
    "@types/node": "^26.1.2",
    "cross-env": "^10.1.0",
    "oxc-parser": "^0.143.0",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "tsx": "^4.23.8",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.5.0"
}
